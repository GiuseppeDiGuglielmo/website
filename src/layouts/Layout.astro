---
import profile from '../data/profile.json';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
}

const { title, description, jsonLd } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <style is:global>
      :root {
        --fg: #16181d;
        --fg-muted: #5a6069;
        --bg: #fdfdfc;
        --accent: #1a4f8a;
        --rule: #e2e2df;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --fg: #e6e6e3;
          --fg-muted: #9aa0a8;
          --bg: #16181d;
          --accent: #8ab4e8;
          --rule: #2c2f36;
        }
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0 auto;
        max-width: 64rem;
        padding: 2rem 1.5rem 3rem;
        background: var(--bg);
        color: var(--fg);
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI",
          Roboto, Helvetica, Arial, sans-serif;
        font-size: 1.0625rem;
        line-height: 1.65;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
      }

      h1,
      h2,
      h3 {
        line-height: 1.25;
        letter-spacing: -0.015em;
        margin: 2.5rem 0 0.75rem;
      }

      h1 {
        font-size: 2rem;
        margin-top: 0;
      }

      h2 {
        font-size: 1.25rem;
      }

      p {
        margin: 0 0 1rem;
      }

      a {
        color: var(--accent);
        text-decoration-thickness: 1px;
        text-underline-offset: 2px;
      }

      a:hover {
        text-decoration-thickness: 2px;
      }

      ul {
        padding-left: 1.25rem;
        margin: 0 0 1.5rem;
      }

      li {
        margin-bottom: 0.4rem;
      }


      /* Two-column shell: profile sidebar + content */
      .layout {
        display: grid;
        gap: 2.5rem;
      }

      @media (min-width: 56rem) {
        .layout {
          grid-template-columns: 14rem 1fr;
          gap: 3.5rem;
        }

        .profile {
          position: sticky;
          top: 2rem;
          align-self: start;
        }
      }

      /* Portrait floats right inside the content column, text wraps */
      .portrait {
        float: right;
        width: 7rem;
        aspect-ratio: 1;
        object-fit: cover;
        border-radius: 3px;
        margin: 0.25rem 0 1rem 1.5rem;
      }

      /* Too narrow to wrap text beside it, so stack instead */
      @media (max-width: 34rem) {
        .portrait {
          float: none;
          display: block;
          margin: 0 0 1.25rem;
        }
      }

      /* Keep later headings from riding up beside the float */
      h2 {
        clear: both;
      }

      .profile__name {
        font-size: 1.125rem;
        font-weight: 600;
        line-height: 1.3;
        margin-bottom: 0.75rem;
      }

      .profile__role {
        color: var(--fg-muted);
        font-size: 0.9375rem;
        line-height: 1.45;
        margin-bottom: 0.6rem;
      }

      .profile__links {
        list-style: none;
        padding: 0;
        margin: 1.25rem 0 0;
        font-size: 0.9375rem;
      }

      .profile__links li {
        margin-bottom: 0.35rem;
      }

      footer {
        margin-top: 4rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--rule);
        color: var(--fg-muted);
        font-size: 0.875rem;
      }

      section {
        margin-bottom: 2rem;
      }
    </style>
  </head>
  <body>

    <div class="layout">
      <aside class="profile">
        <p class="profile__name">{profile.name}</p>
        {profile.affiliations.map((a) => (
          <p class="profile__role">{a.role}, {a.division}, {a.name}</p>
        ))}
        <ul class="profile__links">
          <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
          <li><a href={profile.sameAs.github}>GitHub</a></li>
          <li><a href={profile.sameAs.linkedin}>LinkedIn</a></li>
          <li><a href={profile.sameAs.googleScholar}>Google Scholar</a></li>
        </ul>
      </aside>

      <main>
        <slot />
      </main>
    </div>

    <footer>
      <p>&copy; {new Date().getFullYear()} Giuseppe Di Guglielmo</p>
    </footer>
  </body>
</html>
