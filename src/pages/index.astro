---
import Layout from '../layouts/Layout.astro';
import profile from '../data/profile.json';
import Portrait from '../components/Portrait.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: 'https://gdg.engineer/',
  mainEntity: {
    '@type': 'Person',
    name: profile.name,
    url: 'https://gdg.engineer/',
    jobTitle: profile.title,
    email: profile.email,
    image: new URL(profile.photo, 'https://gdg.engineer/').href,
    description: profile.bioShort,
    worksFor: profile.affiliations.map((a) => ({
      '@type': 'Organization',
      name: a.name,
      department: {
        '@type': 'Organization',
        name: a.division,
      },
    })),
    alumniOf: profile.previousAffiliations.map((a) => ({
      '@type': 'Organization',
      name: a.name,
    })),
    knowsAbout: [
      'ASIC Design',
      'FPGA Design',
      'AI Hardware',
      'High-Level Synthesis',
      'Machine Learning Accelerators',
      'Computer Architecture',
      'Ultra-Low-Latency Computing',
    ],
    sameAs: Object.values(profile.sameAs).filter((v) => v && v !== 'TODO'),
  },
};
---

<Layout
  title="Giuseppe Di Guglielmo | Principal Engineer, AI Hardware, ASIC & FPGA"
  description={profile.metaDescription}
  jsonLd={jsonLd}
>
  <h1>{profile.name}</h1>
  <Portrait />
  <p>{profile.bioLong}</p>

  <section>
    <h2>Previously</h2>
    <ul>
      {profile.previousAffiliations.map((a) => (
        <li>{a.role}, {a.name}</li>
      ))}
    </ul>
  </section>
</Layout>
